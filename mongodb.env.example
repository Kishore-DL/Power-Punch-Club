MONGODB_URI="mongodb+srv://<database-user>:<password>@<atlas-host>/?retryWrites=true&w=majority"
MONGODB_DATABASE=power_punch_club
# Optional DNS override if your network cannot resolve Atlas SRV records.
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8
PPC_CLIENT_PREVIEW=true
PPC_SESSION_SECRET="<at-least-32-random-characters>"
# Keep these keys stable and backed up. Generate each hex key with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
PPC_TRACKING_DIGEST_KEY="<64-hex-characters>"
PPC_TRACKING_ACTIVE_KEY=v1
PPC_TRACKING_KEYS='{"v1":"<64-hex-characters>"}'
PPC_BOOTSTRAP_ADMIN_ID="<your-login-id>"
PPC_BOOTSTRAP_ADMIN_PASSWORD="<your-password-at-least-12-characters>"
# Set false to accept real registrations. Keep true for mock-content presentations.
# PPC_PUBLIC_ORIGIN=https://your-owned-domain.in
# PPC_TRUSTED_IP_HEADER=x-forwarded-for
# Configure only the IP header securely supplied by your actual hosting ingress.
PPC_WRITE_RATE_LIMIT=120
# Optional Razorpay (manual UPI QR does not need these)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# Brevo transactional email: server-only settings, never NEXT_PUBLIC_.
# Notifications go ONLY to this administrator. No participant email delivery.
ADMIN_NOTIFICATION_EMAIL=
BREVO_API_KEY="your-brevo-api-key"
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME="Power Punch Club"
# breve api : replace-with-your-brevo-api-key